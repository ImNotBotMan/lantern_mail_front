VITE_API_BASE_URL=/api

# Firebase: web-конфиг проекта (Firebase Console → Project settings → Your apps).
# Без ключей кнопка «Продолжить с Google» не показывается, остальной вход работает.
# VITE_FIREBASE_API_KEY=AIza...
# VITE_FIREBASE_AUTH_DOMAIN=lantern-mail.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=lantern-mail
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef
